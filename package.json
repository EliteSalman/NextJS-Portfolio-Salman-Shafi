{
  "name": "salman-shafi-astro-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:cloudflare": "astro check --config astro.config.cloudflare.mjs && astro build --config astro.config.cloudflare.mjs",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy --config wrangler.deploy.toml",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "nodemailer": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  }
}
